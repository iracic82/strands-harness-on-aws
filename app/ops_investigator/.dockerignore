# IAM policy documents. CDK reads these from the local disk at synth time (relative to
# codeLocation) and attaches them as inline policies on the execution role, so they must
# exist in the repo but must never ship inside the image.
policies/

# Local harness session state written by `agentcore dev` / local runs.
.agent/
