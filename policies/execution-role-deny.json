{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoSecretMaterial",
      "Comment": "JSON has no comments, so this annotation key carries the caveat; CDK's PolicyDocument.fromJson drops unknown statement keys, so it never reaches IAM. CAVEAT: if this agent ever gains an AgentCore credential provider (an API-key or OAuth entry under credentials[] in agentcore.json), the secretsmanager:GetSecretValue deny below must gain a NotResource carve-out for the provider's secrets, whose names start with bedrock-agentcore-identity!, or the runtime cannot fetch its own outbound credentials.",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "kms:GenerateDataKey*",
        "s3:GetObject*",
        "s3:SelectObjectContent",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:PartiQLSelect",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetLayerVersion",
        "ec2:GetPasswordData",
        "ec2:GetConsoleOutput",
        "ec2:GetConsoleScreenshot",
        "ec2:DescribeInstanceAttribute",
        "cloudformation:GetTemplate",
        "ecs:DescribeTaskDefinition",
        "codebuild:BatchGetProjects",
        "cognito-idp:AdminGetUser",
        "cognito-idp:ListUsers",
        "sqs:ReceiveMessage",
        "kinesis:GetRecords",
        "kinesis:GetShardIterator",
        "sts:AssumeRole",
        "sts:GetFederationToken",
        "sts:GetSessionToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoDirectKmsDecrypt",
      "Comment": "Image pull runs as the execution role, and a CMK-encrypted ECR repository needs kms:Decrypt on the pull path. A blanket Deny on kms:Decrypt wins over the CDK's grant and the runtime can never start, so this denies only calls the agent could make itself and leaves the ECR service principal path open.",
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "kms:ViaService": ["ecr.*.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "NoApiKeys",
      "Effect": "Deny",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:*::/apikeys*"
    },
    {
      "Sid": "NoReadingOwnTranscripts",
      "Effect": "Deny",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/bedrock-agentcore/*",
        "arn:aws:logs:*:*:log-group:aws/spans*"
      ]
    }
  ]
}
