# Copied to .env by `make setup`, which fills in the region and the account id STS reports. .env is
# git-ignored; this example is not. Only non-secret settings live here.
#
# Nothing in this repo auto-loads .env: there is no dotenv dependency, and the Makefile passes
# --region to every script on its own. It is a convenience for your own shell:
#
#     set -a; . ./.env; set +a
#
AWS_REGION=<region>
# Both variables, always: botocore resolves the region from AWS_DEFAULT_REGION and the profile
# config only, so a client built without an explicit region_name never sees AWS_REGION. PITFALLS P28.
AWS_DEFAULT_REGION=<region>
# Not read by the agent; it is here so `echo $AWS_ACCOUNT_ID` answers "which account am I in".
AWS_ACCOUNT_ID=<account-id>
HARNESS_MODEL=bedrock/global.anthropic.claude-sonnet-4-6
HARNESS_EFFORT=medium
# DEMO_PASSWORD is read from the environment, never from a file. Export it in your shell before
# `make auth-bootstrap`.
